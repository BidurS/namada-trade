{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namada-trade",
  "main": "worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Production domain. `custom_domain` makes Cloudflare create the DNS records and certificate.
  "routes": [
    { "pattern": "namada.trade", "custom_domain": true },
    { "pattern": "www.namada.trade", "custom_domain": true }
  ],

  // Static UI (built by Vite). API + WebSocket routes always hit the Worker first.
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namada-trade-db",
      "database_id": "9073901c-274f-4c3f-ba02-65e2241540d6",
      "migrations_dir": "migrations"
    }
  ],

  // The depth archive (docs: depth plan 1.6): one gzipped object per live pool per hour, written by the hourly depth
  // job (step S3). Created once by the owner with `wrangler r2 bucket create namada-trade-depth`; the code tolerates the
  // binding missing (worker/src/util.ts Env.DEPTH_R2 is optional) and then writes no archive and says so.
  "r2_buckets": [{ "binding": "DEPTH_R2", "bucket_name": "namada-trade-depth" }],

  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveHub"] }],

  // Exports, address reports, quotes, and every write (sign-in, pairing, tags, settings): 30 a minute per client
  // address and path family (worker/src/http.ts rateLimited). The search and the lists searched by text: 120 a
  // minute (SEARCH_LIMITER; typing in the palette sends one request per pause). Rewound reads, metric histories and
  // the list variants with many values (a size, a page past the first, a cursor), which miss the edge cache by
  // design: 120 a minute (replayLimited). namespace_id is any number unique to this account.
  "ratelimits": [
    { "name": "HEAVY_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "REPLAY_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    // The Osmosis quote service calls every visitor's quotes may make together, 10 per 10 s under one fixed key: the
    // counters are per Cloudflare location, as is the outbound address the quote service limits (worker/src/api.ts
    // quoteBudget). Past it a quote answers 'busy' and the page shows its size table.
    { "name": "QUOTE_LIMITER", "namespace_id": "1004", "simple": { "limit": 10, "period": 10 } },
    // /ws upgrade attempts, 60 a minute per client address (worker/src/http.ts wsLimited), counted before the one
    // LiveHub object sees them: its admission bounds open sockets only, and every attempt is an event in the object
    // that runs the scan.
    { "name": "WS_LIMITER", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } }
  ],

  // Every minute: holders refresh, prices, supply split, integrity checks, gap-fill.
  "triggers": { "crons": ["* * * * *"] },

  "vars": {
    // Whale thresholds in NAM (user choice: 10k on both chains).
    "WHALE_OSMOSIS_NAM": "10000",
    "WHALE_NAMADA_NAM": "10000"
  }

  // Secrets (set with `wrangler secret put <NAME>`, locally in .dev.vars):
  //   KEPLR_KEY            -> keplr_xxx path key for api.keplr.app
  //   DISCORD_WEBHOOK_URL  -> whale alerts
  //   SEND_ALERTS          -> yes: this Worker posts alerts. Production only (scripts/deploy-check.sh checks it); never in
  //                           .dev.vars, so a local run, even on a copy of the production database, posts none
  //   SETTINGS_KEY         -> AES-256-GCM key for users' settings (worker/src/settings.ts); production's is piped straight
  //                           into the secret and kept in no file, and .dev.vars holds a development key of its own
  //   TELEGRAM_BOT_TOKEN   -> the Telegram bot's token from @BotFather (worker/src/sources/telegram.ts); without it nothing
  //                           goes to Telegram. Piped straight into the secret, kept in no file
  //   TELEGRAM_WEBHOOK_SECRET -> random, 32+ characters: Telegram sends it with each update (scripts/telegram-setup.mjs
  //                           sets the webhook with it); the webhook answers 404 without it
  //   TELEGRAM_CHANNEL     -> optional: the public channel of the site's own alerts ("@name"), the bot an admin there
  //   ACCESS_AUD           -> optional: Cloudflare Access application AUD tag (checks the header is present only; Access itself is enforced at the edge)
}
